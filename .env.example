# Database connection (read-only access to coordinator PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Server port (default: 3001)
PORT=3001

# CORS origin (optional — set for development when frontend runs on different port)
# CORS_ORIGIN=http://localhost:5173

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=100

# GitHub config for fetching PCR registry from epsilon-enclave repo
# Token is optional for public repos, required for private repos
GITHUB_OWNER=epsilon-data
GITHUB_REPO=epsilon-enclave
GITHUB_TOKEN=

# Fallback PCR values (used only when GitHub fetch fails)
# From: nitro-cli describe-eif --eif-path epsilon-enclave.eif
EXPECTED_PCR0=
EXPECTED_PCR1=
EXPECTED_PCR2=

# ATL (Attestation Transparency Log) — optional
# If set, enables transparency log features (log explorer, inclusion proofs)
ATL_BASE_URL=http://localhost:8080
